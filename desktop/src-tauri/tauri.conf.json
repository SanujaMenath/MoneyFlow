{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoneyFlow",
  "version": "1.6.0",
  "identifier": "com.sanuja-menath.moneyflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MoneyFlow",
        "width": 1024,
        "height": 748,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co https://openrouter.ai https://api.openai.com https://api-inference.huggingface.co; img-src 'self' data: https://*.supabase.co https://storage.googleapis.com; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
